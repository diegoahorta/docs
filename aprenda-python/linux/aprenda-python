#!/usr/bin/python3
"""Aprenda Python — lançador para Linux (Debian/Ubuntu).

Serve o app (HTML/JS + Python 3.14 em WebAssembly) a partir de um servidor local
em 127.0.0.1 e abre uma janela do navegador. Funciona totalmente offline.

Uso:
  aprenda-python                 abre o app
  aprenda-python --sem-navegador só inicia o servidor e mostra o endereço
  aprenda-python --porta 50000   usa outra porta (o progresso é salvo por porta)
  aprenda-python --versao

Variável APRENDA_PYTHON_NAVEGADOR: comando do navegador a usar (ex.: firefox).
"""
import argparse
import http.server
import json
import os
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.request
import webbrowser

VERSAO = "1.0.0"
PORTA_PADRAO = 48765
IDENT = "aprenda-python"
PASTA_WEB = os.environ.get("APRENDA_PYTHON_WEB", "/usr/share/aprenda-python/web")
DADOS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "aprenda-python")

TIPOS = {
    ".html": "text/html; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".mjs": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".wasm": "application/wasm",
    ".zip": "application/zip",
    ".md": "text/markdown; charset=utf-8",
    ".py": "text/plain; charset=utf-8",
    ".svg": "image/svg+xml",
    ".png": "image/png",
}

CHROMIUMS = ["chromium", "chromium-browser", "google-chrome", "google-chrome-stable",
             "microsoft-edge", "microsoft-edge-stable", "brave-browser", "vivaldi"]


class Estado:
    ultimo_ping = None
    inicio = time.monotonic()


class Manipulador(http.server.SimpleHTTPRequestHandler):
    extensions_map = dict(http.server.SimpleHTTPRequestHandler.extensions_map, **TIPOS)

    def __init__(self, *a, **kw):
        super().__init__(*a, directory=PASTA_WEB, **kw)

    def do_GET(self):
        if self.path.startswith("/__aprenda-python/"):
            Estado.ultimo_ping = time.monotonic()
            corpo = json.dumps({"app": IDENT, "versao": VERSAO}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(corpo)))
            self.end_headers()
            self.wfile.write(corpo)
            return
        super().do_GET()

    def end_headers(self):
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()

    def log_message(self, *a):
        pass  # silencioso


def ja_rodando(porta):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{porta}/__aprenda-python/id", timeout=1) as r:
            return json.load(r).get("app") == IDENT
    except Exception:
        return False


def porta_livre(porta):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("127.0.0.1", porta))
            return True
        except OSError:
            return False


def escolher_porta(pedida):
    """A porta precisa ser sempre a mesma: o progresso (localStorage) fica guardado por endereço."""
    if pedida:
        return pedida
    os.makedirs(DADOS, exist_ok=True)
    arq = os.path.join(DADOS, "porta")
    try:
        with open(arq) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        pass
    porta = PORTA_PADRAO
    while not porta_livre(porta) and not ja_rodando(porta):
        porta += 1
    with open(arq, "w") as f:
        f.write(str(porta))
    return porta


def achar_chromium():
    for nome in CHROMIUMS:
        caminho = shutil.which(nome)
        if caminho:
            return caminho
    return None


def abrir_navegador(url):
    """Abre o app. Devolve o processo do navegador quando ele roda numa janela própria."""
    escolhido = os.environ.get("APRENDA_PYTHON_NAVEGADOR")
    chromium = None if escolhido else achar_chromium()
    if chromium:
        perfil = os.path.join(DADOS, "navegador")
        os.makedirs(perfil, exist_ok=True)
        return subprocess.Popen([
            chromium, f"--app={url}", f"--user-data-dir={perfil}", "--class=aprenda-python",
            "--no-first-run", "--no-default-browser-check", "--window-size=1100,860",
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if escolhido:
        subprocess.Popen(escolhido.split() + [url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        webbrowser.open(url, new=1)
    return None


def main():
    ap = argparse.ArgumentParser(prog="aprenda-python", description="Aprenda Python — curso de Python offline")
    ap.add_argument("--porta", type=int, help="porta local (padrão: %d)" % PORTA_PADRAO)
    ap.add_argument("--sem-navegador", action="store_true", help="só inicia o servidor")
    ap.add_argument("--versao", action="version", version="aprenda-python " + VERSAO)
    args = ap.parse_args()

    if not os.path.isfile(os.path.join(PASTA_WEB, "index.html")):
        sys.exit(f"Arquivos do app não encontrados em {PASTA_WEB}")

    porta = escolher_porta(args.porta)
    url = f"http://127.0.0.1:{porta}/index.html"

    if ja_rodando(porta):
        # outra instância já serve o app: só abre uma nova janela
        if not args.sem_navegador:
            abrir_navegador(url)
        print(url)
        return

    servidor = http.server.ThreadingHTTPServer(("127.0.0.1", porta), Manipulador)
    servidor.daemon_threads = True
    threading.Thread(target=servidor.serve_forever, daemon=True).start()
    print(f"Aprenda Python {VERSAO} em {url}", flush=True)

    try:
        if args.sem_navegador:
            while True:
                time.sleep(3600)
        proc = abrir_navegador(url)
        if proc is not None:
            proc.wait()
            # O Chromium pode repassar a janela a um processo já aberto com o mesmo perfil
            # e sair na hora; nesse caso seguimos vivos enquanto a página mandar sinais.
            if time.monotonic() - Estado.inicio > 5:
                return
        # Navegador comum: encerra quando a página parar de enviar sinais (aba fechada).
        while True:
            time.sleep(5)
            agora = time.monotonic()
            if Estado.ultimo_ping is None:
                if agora - Estado.inicio > 180:
                    return
            elif agora - Estado.ultimo_ping > 60:
                return
    except KeyboardInterrupt:
        pass
    finally:
        servidor.shutdown()


if __name__ == "__main__":
    main()
