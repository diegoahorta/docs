<?xml version="1.0" encoding="utf-8"?>
<!-- Dados pessoais (livros, anotações) não são enviados a backups na nuvem. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
