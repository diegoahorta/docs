    {
      "id": "u1",
      "title": "Where were you?",
      "subtitle": "was / were — afirmativa",
      "block": "A",
      "color": "#FF6B4A",
      "guide": [
        { "h": "Forma", "p": "am / is → was · are → were. Truque: were só com you, we, they." },
        { "h": "Função", "p": "Dizer onde alguém ESTAVA e como algo ERA no passado: lugar (I was at home), sentimento (we were tired), descrição (the hotel was nice), idade (she was 22) e tempo (it was sunny)." },
        { "h": "Em português", "p": "was/were vira “era”, “estava” ou “foi”. O inglês usa a mesma forma para os três." }
      ],
      "examples": [
        ["I was tired last night.", "Eu estava cansado ontem à noite."],
        ["We were at the cinema yesterday.", "Nós estávamos no cinema ontem."],
        ["The beach was beautiful.", "A praia estava linda."]
      ],
      "items": [
        { "t": "choice", "lvl": 1, "q": "I ___ tired last night, so I went to bed early.", "o": ["was", "were", "did"], "a": "was", "tip": "I → was." },
        { "t": "choice", "lvl": 1, "q": "We ___ at the cinema yesterday.", "o": ["were", "was", "are"], "a": "were", "tip": "we → were. yesterday pede passado." },
        { "t": "choice", "lvl": 1, "q": "The film ___ funny. We laughed a lot.", "o": ["was", "were", "is"], "a": "was", "tip": "the film = it → was." },
        { "t": "choice", "lvl": 1, "q": "My parents ___ in Rio last weekend.", "o": ["were", "was", "did"], "a": "were", "tip": "my parents = they → were." },
        { "t": "choice", "lvl": 2, "q": "Last year Rachel ___ 22. Now she is 23.", "o": ["was", "had", "were"], "a": "was", "tip": "Idade usa to be: she was 22 (não had)." },
        { "t": "choice", "lvl": 1, "q": "It ___ sunny on Saturday.", "o": ["was", "were", "did"], "a": "was", "tip": "Tempo/clima: it was sunny." },
        { "t": "choice", "lvl": 2, "q": "Leo and Mei ___ at school on Monday.", "o": ["were", "was", "is"], "a": "were", "tip": "Leo and Mei = they → were." },
        { "t": "choice", "lvl": 2, "q": "When I ___ a child, I was scared of dogs.", "o": ["was", "were", "am"], "a": "was", "tip": "When I was a child = quando eu era criança." },
