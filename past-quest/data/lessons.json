        { "t": "build", "lvl": 2, "pt": "A praia estava linda.", "a": "The beach was beautiful", "x": ["were", "is"] },
        { "t": "type", "lvl": 2, "q": "Where ___ you yesterday afternoon?", "hint": "be", "a": ["were"], "tip": "you → were." },
        { "t": "type", "lvl": 2, "q": "The weather ___ nice on Saturday.", "hint": "be", "a": ["was"], "tip": "the weather = it → was." },
        { "t": "type", "lvl": 3, "q": "My friends ___ at the party.", "hint": "be", "a": ["were"], "tip": "my friends = they → were." },
        { "t": "listen", "lvl": 2, "say": "We were at home last night.", "o": ["We were at home last night.", "We are at home tonight.", "He was at home last night."] },
