        { "t": "fix", "lvl": 3, "s": "She had 22 years last year.", "bad": 1, "fixed": "She was 22 last year.", "tip": "Idade: to be (was), não have." },
        { "t": "fix", "lvl": 3, "s": "They was at the beach.", "bad": 1, "fixed": "They were at the beach.", "tip": "they → were." }
