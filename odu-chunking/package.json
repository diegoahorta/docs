    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "build:lexico": "node scripts/build-lexico.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "live-server": "^1.2.2",
    "prettier": "^3.6.2"
  }
}
