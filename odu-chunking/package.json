{
  "name": "odu-blocos",
  "version": "1.0.0",
  "private": true,
  "description": "Inglês, francês, alemão e espanhol ao mesmo tempo com o método de Chunking da ODU Creative.",
  "type": "module",
  "scripts": {
    "start": "live-server --port=5500 --open=index.html --ignore=node_modules",
    "lint": "eslint .",
