{
  "name": "odu-blocos",
  "version": "1.0.1",
  "private": true,
  "description": "Inglês, francês, alemão e espanhol ao mesmo tempo com o método de Chunking da ODU Creative.",
  "type": "module",
  "scripts": {
    "start": "live-server --port=5500 --open=index.html --ignore=node_modules,android,www",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "build:lexico": "node scripts/build-lexico.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "vendor": "node scripts/vendor.mjs",
    "audio:roteiro": "node scripts/audio.mjs roteiro",
    "audio:manifest": "node scripts/audio.mjs manifest",
    "build:www": "npm run audio:manifest && node scripts/build-www.mjs",
    "android:build": "npm run build:www && node scripts/build-apk.mjs",
    "android:tools": "node scripts/android-tools.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "aaptjs3": "^2.0.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "gsap": "^3.12.5",
    "live-server": "^1.2.2",
    "phaser": "^3.80.1",
    "prettier": "^3.6.2",
    "three": "^0.160.0"
  }
}
